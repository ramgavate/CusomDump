# Source MongoDB connection string.
SOURCE_URI=mongodb+srv://user:password@source-cluster.example.mongodb.net

# Source database name.
DB_NAME=source_database

# Number of random documents to export per collection.
SAMPLE_SIZE=500

# Output directory for exported JSON files.
OUT_DIR=dump

# Set true to also create a zip file.
ZIP=false

# Set true only if you need MongoDB system collections.
INCLUDE_SYSTEM=false

# Target MongoDB connection string.
TARGET_URI=mongodb+srv://user:password@target-cluster.example.mongodb.net

# Target database name. If empty, import scripts use the dump folder name.
TARGET_DB=target_database
